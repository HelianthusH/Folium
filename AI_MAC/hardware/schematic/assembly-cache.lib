#encoding utf-8
# USB-C_panel
DEF USB-C_panel J 0 40 Y Y 1 F N
F0 "J" 0 750 50 H V C CNN
F1 "USB-C_panel" 0 640 50 H V C CNN
DRAW
S -650 600 620 -100 0 1 10 f
X VBUS 1 -850 500 200 R 45 45 1 1 P
X D+ 2 -850 400 200 R 45 45 1 1 P
X D- 3 -850 300 200 R 45 45 1 1 P
X CC1 4 -850 200 200 R 45 45 1 1 P
X CC2 5 -850 100 200 R 45 45 1 1 P
X GND 6 -850 0 200 R 45 45 1 1 P
ENDDRAW
ENDDEF
