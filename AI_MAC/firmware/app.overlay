#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
/ {
  keys_voice {
    compatible = "gpio-keys";
    record_key: record { gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
    dictate_key: dictate { gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
  };
};
&pinctrl {
  vc_spi_default: vc_spi_default { group1 { psels = <NRF_PSEL(SPIM_SCK,1,13)>, <NRF_PSEL(SPIM_MISO,1,14)>, <NRF_PSEL(SPIM_MOSI,1,15)>; }; };
  vc_spi_sleep: vc_spi_sleep { group1 { psels = <NRF_PSEL(SPIM_SCK,1,13)>, <NRF_PSEL(SPIM_MISO,1,14)>, <NRF_PSEL(SPIM_MOSI,1,15)>; low-power-enable; }; };
};
&spi2 {
  compatible = "nordic,nrf-spim";
  status = "okay";
  pinctrl-0 = <&vc_spi_default>; pinctrl-1 = <&vc_spi_sleep>;
  pinctrl-names = "default", "sleep";
  cs-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;
  sdhc@0 {
    compatible = "zephyr,sdhc-spi-slot"; reg = <0>; status = "okay";
    spi-max-frequency = <8000000>;
    mmc { compatible = "zephyr,sdmmc-disk"; disk-name = "SD"; status = "okay"; };
  };
};
&pdm0 { status = "okay"; queue-size = <68>; };
&uart0 { status = "disabled"; };

